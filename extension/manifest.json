{
  "manifest_version": 3,
  "name": "WhatsApp Web Message Extractor",
  "version": "1.0.0",
  "description": "Captura y lista mensajes de chats de WhatsApp Web al posar sobre ellos o con un solo clic.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://spa-software.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Message Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "page_bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "aurasystem.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "aurasystem.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
